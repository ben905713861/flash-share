{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flash Share",
  "version": "1.0.0",
  "identifier": "com.wuxb.flashshare",
  "build": {
    "devUrl": "http://localhost:8082",
    "beforeDevCommand": "npm run tauri-web",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run tauri-web-build"
  },
  "app": {
    "windows": [
      {
        "title": "Flash Share",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQ0JBOTIzM0Y1NjAwQUIKUldTckFGWS9JNm5MZkJ2bVkrWHlYQllyRjNEcmc0SHhJYjExQnA0ZEM0N3hlNXhQZk9QYXhwSUsK",
      "endpoints": [
        "https://github.com/ben905713861/flash-share/releases/latest/download/latest.json"
      ]
    }
  }
}
