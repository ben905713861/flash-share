{
  "expo": {
    "name": "Flash Share",
    "slug": "flash-share",
    "version": "1.0.0",
    "description": "Pair devices and share text or files directly, without uploading them to a central service.",
    "orientation": "portrait",
    "icon": "./assets/images/flash-share-icon.png",
    "scheme": "flashshare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/flash-share-icon.png",
      "bitcode": false,
      "bundleIdentifier": "com.wuxb.flashshare"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33",
        "foregroundImage": "./assets/images/flash-share-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.wuxb.flashshare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/flash-share-favicon.png"
    },
    "extra": {
      "supportEmail": "ben905713861@gmail.com",
      "supportUrl": "https://github.com/ben905713861/flash-share",
      "privacyPolicyUrl": "https://ben905713861.github.io/flash-share/privacy.html",
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.wuxb.flashshare.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.wuxb.flashshare.share"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3c591de7-e5de-4a72-8d64-1e2f72953ffe"
      }
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "./plugins/with-android-architectures",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 100
          },
          "iosAppGroupIdentifier": "group.com.wuxb.flashshare.share"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F33",
          "image": "./assets/images/flash-share-splash.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
